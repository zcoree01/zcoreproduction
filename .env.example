# Copy to .env.local and fill in. Never commit .env.local.

# --- Public (exposed to the browser) ---
# Supabase project URL and anon key (Dashboard → Project Settings → API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (NEVER prefix with NEXT_PUBLIC_) ---
# Service-role key. Only for trusted server code and scripts; bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local demo/test credentials (never commit real values) ---
# Shared password of all demo users (applied by npm run seed:demo), min 12 chars.
DEMO_PASSWORD=
# Password of the test tenants' users (npm run test:db, npm run e2e), min 12 chars.
TEST_TENANT_PASSWORD=
